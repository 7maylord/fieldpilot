generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @db.Uuid
  email                 String   @unique
  passwordHash          String   @map("password_hash")
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  sessions              Session[]
  memberships           Membership[]
  syncDevices           SyncDevice[]

  @@map("users")
}

model Session {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  refreshTokenHash   String    @unique @map("refresh_token_hash")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  refreshExpiresAt   DateTime  @map("refresh_expires_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("password_reset_tokens")
}

model IdentityOutboxEvent {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  eventType   String   @map("event_type")
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("identity_outbox_events")
}

model Organization {
  id        String       @id @db.Uuid
  name      String
  slug      String       @unique
  createdBy String       @map("created_by") @db.Uuid
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  members  Membership[]
  teams     Team[]
  projects  Project[]
  syncDevices SyncDevice[]

  @@map("organizations")
}

model Membership {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  status         String       @default("active")
  isExternal     Boolean      @default(false) @map("is_external")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Invitation {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  role           String
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId])
  @@map("organization_invitations")
}

model Team {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMembership {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  version        Int    @default(1)

  @@unique([teamId, userId])
  @@index([organizationId])
  @@map("team_memberships")
}

model ProjectAccess {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  projectId      String @map("project_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  version        Int    @default(1)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organizationId])
  @@map("project_access")
}

model Project {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  client         String?
  status         String   @default("draft")
  timezone       String
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  address        String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  access         ProjectAccess[]
  sites          Site[]
  locations      Location[]
  workOrders     WorkOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("projects")
}

model Site {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  name           String
  code           String
  status         String   @default("active")
  boundary       Unsupported("geometry")?
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locations      Location[]
  workOrders     WorkOrder[]

  @@unique([organizationId, projectId, code])
  @@index([organizationId, projectId])
  @@map("sites")
}

model Location {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  locationType   String   @map("location_type")
  status         String   @default("active")
  geometry       Unsupported("geometry")?
  chainageStart  Decimal? @map("chainage_start") @db.Decimal
  chainageEnd    Decimal? @map("chainage_end") @db.Decimal
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent         Location? @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Location[] @relation("LocationHierarchy")
  workOrders     WorkOrder[]

  @@index([organizationId, projectId, siteId])
  @@index([parentId])
  @@map("locations")
}

model WorkOrder {
  id                   String   @id @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  siteId               String?  @map("site_id") @db.Uuid
  locationId           String?  @map("location_id") @db.Uuid
  title                String
  description          String?
  workType             String   @map("work_type")
  priority             String
  status               String   @default("draft")
  plannedStart         DateTime? @map("planned_start") @db.Timestamptz
  plannedEnd           DateTime? @map("planned_end") @db.Timestamptz
  dueAt                DateTime? @map("due_at") @db.Timestamptz
  estimatedMinutes     Int?      @map("estimated_minutes")
  requiredSkills       String[]  @default([]) @map("required_skills")
  evidenceRequirements Json      @default("[]") @map("evidence_requirements")
  completionRules      Json      @default("{}") @map("completion_rules")
  checklistId          String?   @map("checklist_id") @db.Uuid
  version              Int       @default(1)
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site                 Site?     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  location             Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignments          WorkOrderAssignment[]
  prerequisites        WorkOrderDependency[] @relation("DependentWorkOrder")
  dependents           WorkOrderDependency[] @relation("PrerequisiteWorkOrder")

  @@index([organizationId, projectId, status])
  @@index([organizationId, dueAt])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  assigneeType   String   @map("assignee_type")
  assigneeId     String   @map("assignee_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, assigneeType, assigneeId])
  @@index([organizationId, assigneeType, assigneeId])
  @@map("work_order_assignments")
}

model WorkOrderDependency {
  id                      String   @id @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  workOrderId             String   @map("work_order_id") @db.Uuid
  prerequisiteWorkOrderId String   @map("prerequisite_work_order_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  workOrder               WorkOrder @relation("DependentWorkOrder", fields: [workOrderId], references: [id], onDelete: Cascade)
  prerequisite            WorkOrder @relation("PrerequisiteWorkOrder", fields: [prerequisiteWorkOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, prerequisiteWorkOrderId])
  @@index([organizationId])
  @@map("work_order_dependencies")
}

model AuditEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id") @db.Uuid
  requestId      String?  @map("request_id")
  summary        Json
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([organizationId, occurredAt])
  @@map("audit_events")
}

model OutboxEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      String   @map("event_type")
  aggregateId    String   @map("aggregate_id") @db.Uuid
  payload        Json
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

model SyncDevice {
  id                    String    @id @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  name                  String
  platform              String
  appVersion            String    @map("app_version")
  currentCheckpoint     String?   @map("current_checkpoint") @db.Uuid
  packageExpiresAt      DateTime  @map("package_expires_at") @db.Timestamptz
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz
  purgeRequestedAt      DateTime? @map("purge_requested_at") @db.Timestamptz
  purgeReason           String?   @map("purge_reason")
  purgeAcknowledgedAt   DateTime? @map("purge_acknowledged_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations            SyncOperation[]
  conflicts             SyncConflict[]
  checkpoints           SyncCheckpoint[]

  @@index([organizationId, userId])
  @@map("sync_devices")
}

model SyncOperation {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  deviceId          String    @map("device_id") @db.Uuid
  clientOperationId String    @map("client_operation_id") @db.Uuid
  entityType        String    @map("entity_type")
  entityId          String    @map("entity_id") @db.Uuid
  operationType     String    @map("operation_type")
  baseVersion       Int?      @map("base_version")
  payload           Json
  status            String
  rejectionCode     String?   @map("rejection_code")
  conflictId        String?   @map("conflict_id") @db.Uuid
  clientCreatedAt   DateTime  @map("client_created_at") @db.Timestamptz
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz
  appliedAt         DateTime? @map("applied_at") @db.Timestamptz
  device            SyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  conflict          SyncConflict? @relation(fields: [conflictId], references: [id], onDelete: SetNull)

  @@unique([organizationId, deviceId, clientOperationId])
  @@index([organizationId, receivedAt])
  @@map("sync_operations")
}

model SyncConflict {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id") @db.Uuid
  operationType  String    @map("operation_type")
  localValue     Json      @map("local_value")
  serverValue    Json      @map("server_value")
  status         String    @default("unresolved")
  resolution     Json?
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  device         SyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  operations     SyncOperation[]

  @@index([organizationId, status, createdAt])
  @@map("sync_conflicts")
}

model SyncCheckpoint {
  token          String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  sequence       BigInt
  projectIds     String[] @map("project_ids") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  device         SyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, deviceId, createdAt])
  @@map("sync_checkpoints")
}

model EntityChangeLog {
  sequence       BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  operationType  String   @map("operation_type")
  version        Int?
  payload        Json
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([organizationId, projectId, sequence])
  @@map("entity_change_log")
}

model JobExecution {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  jobKey         String   @map("job_key")
  completedAt    DateTime @default(now()) @map("completed_at") @db.Timestamptz

  @@unique([organizationId, jobKey])
  @@map("job_executions")
}
