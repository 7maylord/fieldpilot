{
  "title": "FieldPilot Operations",
  "uid": "fieldpilot-operations",
  "schemaVersion": 39,
  "panels": [
    { "type": "timeseries", "title": "HTTP latency and errors", "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(fieldpilot_http_request_duration_seconds_bucket[5m])))" }, { "expr": "sum(rate(fieldpilot_http_request_duration_seconds_count{status=~\"5..\"}[5m]))" }] },
    { "type": "stat", "title": "Database and Redis", "targets": [{ "expr": "fieldpilot_dependency_up" }] },
    { "type": "timeseries", "title": "Queue depth", "targets": [{ "expr": "fieldpilot_queue_jobs" }] },
    { "type": "timeseries", "title": "Sync and conflicts", "targets": [{ "expr": "rate(fieldpilot_domain_events_total{area=~\"sync|conflicts\"}[5m])" }] },
    { "type": "timeseries", "title": "Media and reports", "targets": [{ "expr": "rate(fieldpilot_domain_events_total{area=~\"media|reports\"}[5m])" }] },
    { "type": "stat", "title": "SSE connections", "targets": [{ "expr": "fieldpilot_sse_connections" }] },
    { "type": "timeseries", "title": "Client failures", "targets": [{ "expr": "rate(fieldpilot_client_failures_total[5m])" }] }
  ]
}
